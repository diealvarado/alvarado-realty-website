---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Client Services | Diego Alvarado REALTOR®"
  description="Buyer, seller, investor, property-alert, and real estate wealth-planning services with Diego Alvarado in Flower Mound and North DFW."
>
  <section class="page-hero"><div class="container" style="max-width:42rem;">
    <p class="eyebrow">Client services</p>
    <h1>How Diego works with you</h1>
    <p>Pick the path that fits — or start with a consult and we’ll map the right one together.</p>
  </div></section>
  <section class="section" style="padding-top:0;"><div class="container grid-2">
    <a class="card" href="/buyers/" style="text-decoration:none;color:inherit;">
      <h2 style="font-size:1.35rem;">Buyers</h2>
      <p>Shortlists, tour strategy, and offer clarity — including relocators.</p>
    </a>
    <a class="card" href="/sellers/" style="text-decoration:none;color:inherit;">
      <h2 style="font-size:1.35rem;">Sellers</h2>
      <p>Pricing, prep that matters, and a calm path through negotiations.</p>
    </a>
    <a class="card" href="/investors/" style="text-decoration:none;color:inherit;">
      <h2 style="font-size:1.35rem;">Investors</h2>
      <p>DFW-wide investor help — off-market deals on Alvacom Homes.</p>
    </a>
    <a class="card" href="/property-alerts/" style="text-decoration:none;color:inherit;">
      <h2 style="font-size:1.35rem;">Property alerts</h2>
      <p>Tell Diego what you want — he watches the market and texts or emails matches. No IDX required.</p>
    </a>
    <a class="card" href="/wealth-planning/" style="text-decoration:none;color:inherit;">
      <h2 style="font-size:1.35rem;">Real estate wealth planning</h2>
      <p>Guidance on the real-estate pieces of wealth planning.</p>
    </a>
  </div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home Value | Diego Alvarado" description="Request a home value consult from Diego Alvarado for Flower Mound and North DFW.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Sellers</p><h1>What's my home worth?</h1><p>Share a few details and Diego will follow up with a local read — not a generic online estimate.</p></div></section>
  <section class="section" style="padding-top:0;"><div class="container" style="max-width:34rem;">
    <form class="form card" name="home-value" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
      <input type="hidden" name="form-name" value="home-value" />
      <p hidden><label>Don’t fill this out: <input name="bot-field" /></label></p>
      <label>Name<input required name="name" /></label>
      <label>Email<input required type="email" name="email" /></label>
      <label>Phone<input type="tel" name="phone" /></label>
      <label>Property address<input required name="address" /></label>
      <label>Notes<textarea name="message" placeholder="Timeline, upgrades, questions..."></textarea></label>
      <button class="btn btn-primary" type="submit">Request consult</button>
    </form>
  </div></section>
</BaseLayout>

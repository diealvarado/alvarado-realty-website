---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact Diego Alvarado | Flower Mound REALTOR®" description="Contact Diego Alvarado for buying, selling, relocating, or investing in Flower Mound and North DFW. Hablo Español.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk about your next move</h1>
      <p>Call, email, or send the form — Hablo Español.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0;">
    <div class="container grid-2">
      <div class="card">
        <form class="form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
          <input type="hidden" name="form-name" value="contact" />
          <p hidden><label>Don’t fill this out: <input name="bot-field" /></label></p>
          <label>Name<input required name="name" autocomplete="name" /></label>
          <label>Email<input required type="email" name="email" autocomplete="email" /></label>
          <label>Phone<input type="tel" name="phone" autocomplete="tel" /></label>
          <label>I am a
            <select name="interest">
              <option>Buyer</option>
              <option>Seller</option>
              <option>Relocating</option>
              <option>Investor</option>
              <option>Not sure yet</option>
            </select>
          </label>
          <label>Message<textarea name="message" placeholder="Neighborhoods, timing, questions..."></textarea></label>
          <label style="font-weight:400;font-size:0.9rem;">
            <input type="checkbox" name="sms-consent" />
            <span class="hint">I agree to receive transactional texts about my inquiry. Msg/data rates may apply. Reply STOP to opt out.</span>
          </label>
          <button class="btn btn-primary" type="submit">Send message</button>
        </form>
      </div>
      <div>
        <div class="card">
          <h2>Reach Diego directly</h2>
          <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p>{site.address.full}</p>
          <p class="hint">{site.brokerage} · License #{site.license}</p>
          <p><a href={site.gbp} target="_blank" rel="noopener">Google Business Profile →</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Service Areas | Diego Alvarado REALTOR®"
  description="Flower Mound, Coppell, Grapevine Lake towns, and North DFW communities served by Diego Alvarado."
>
  <section class="page-hero"><div class="container">
    <p class="eyebrow">Areas</p>
    <h1>Flower Mound & North DFW</h1>
    <p>
      Every city below is part of Diego’s active market — from Flower Mound and Coppell
      to the smaller towns tucked around Grapevine Lake.
    </p>
  </div></section>
  <section class="section" style="padding-top:0;"><div class="container">
    <div class="city-list">{areas.map((a) => <a href={`/areas/${a.id}/`}>{a.data.name}</a>)}</div>
  </div></section>
</BaseLayout>

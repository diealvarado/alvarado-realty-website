---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('insights'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Insights | Diego Alvarado" description="North DFW real estate insights from Diego Alvarado — city comparisons, buyer/seller guides, and local notes.">
  <section class="page-hero"><div class="container">
    <p class="eyebrow">Insights</p>
    <h1>Guides & market notes</h1>
    <p>City comparisons, relocator notes, and practical guides for Flower Mound and North DFW.</p>
  </div></section>
  <section class="section" style="padding-top:0;"><div class="container grid-2">
    {posts.map((post) => (
      <a class="card" href={`/insights/${post.id}/`} style="text-decoration:none;color:inherit;">
        <h2 style="font-size:1.25rem;">{post.data.title}</h2>
        <p>{post.data.description}</p>
        <p class="hint">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
      </a>
    ))}
  </div></section>
  <section class="section section-alt"><div class="container" style="max-width:36rem;">
    <h2 style="margin-top:0;">Market notes by email</h2>
    <p>Occasional local updates from Diego — not a daily blast. Unsubscribe anytime.</p>
    <form class="form form-inline" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
      <input type="hidden" name="form-name" value="newsletter" />
      <p hidden><label>Don’t fill this out: <input name="bot-field" /></label></p>
      <label class="sr-only" for="newsletter-email">Email</label>
      <input id="newsletter-email" type="email" name="email" placeholder="Email address" required />
      <button class="btn btn-primary" type="submit">Subscribe</button>
    </form>
  </div></section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('insights'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Insights | Diego Alvarado" description="North DFW real estate insights from Diego Alvarado — city comparisons, buyer/seller guides, and local notes.">
  <section class="page-hero"><div class="container">
    <p class="eyebrow">Insights</p>
    <h1>Guides & market notes</h1>
    <p>Weekly articles built to help humans — and help search engines understand Diego's local expertise.</p>
  </div></section>
  <section class="section" style="padding-top:0;"><div class="container grid-2">
    {posts.map((post) => (
      <a class="card" href={`/insights/${post.id}/`} style="text-decoration:none;color:inherit;">
        <h2 style="font-size:1.25rem;">{post.data.title}</h2>
        <p>{post.data.description}</p>
        <p class="hint">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
      </a>
    ))}
  </div></section>
</BaseLayout>

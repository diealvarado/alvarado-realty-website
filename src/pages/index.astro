---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, cities } from '../data/site';
import { cityImages, featuredCitySlugs, defaultCityImage } from '../data/cityImages';

const featured = featuredCitySlugs.map((slug) => {
  const city = cities.find((c) => c.slug === slug)!;
  return { ...city, img: cityImages[slug] ?? defaultCityImage };
});
const moreCities = cities.filter((c) => !featuredCitySlugs.includes(c.slug as typeof featuredCitySlugs[number]));

const faqs = [
  {
    q: 'What areas does Diego Alvarado serve?',
    a: 'Diego serves Flower Mound, Highland Village, Lewisville, Grapevine, Coppell, Double Oak, Copper Canyon, Bartonville, Northlake, Trophy Club, Roanoke, Argyle & Lantana, Bedford, and Euless — all as active markets, not a secondary tier.',
  },
  {
    q: 'Who does Diego work with?',
    a: 'Buyers, sellers, relocators, and investors who want clear communication, bilingual support (Hablo Español), and advice that respects both lifestyle and numbers.',
  },
  {
    q: 'Is Diego an investor as well as an agent?',
    a: 'Yes. He came into real estate through investing first, then became a licensed Texas REALTOR® with Monument Realty — which shapes how he evaluates risk and timing.',
  },
  {
    q: 'Can you help if I am relocating from another city?',
    a: 'Yes. Remote and multi-timezone moves are a normal part of the practice: structured tours, clear updates, and coordination with lenders, inspectors, and title.',
  },
  {
    q: 'How do I start?',
    a: `Call or text ${site.phone}, email ${site.email}, or use the consultation form. Every relationship starts with timing, budget, and what a good outcome looks like for you.`,
  },
];
---
<BaseLayout>
  <section class="hero-video">
    <video class="hero-video__media" autoplay muted loop playsinline poster="/images/cities/flower-mound.jpg" aria-hidden="true">
      <source src="/videos/local-north-dfw.mp4" type="video/mp4" />
    </video>
    <div class="hero-video__shade"></div>
    <div class="container hero-video__content">
      <p class="eyebrow">Flower Mound · Grapevine Lake · North DFW</p>
      <h1>A clearer path to the right North DFW address.</h1>
      <p>
        Diego Alvarado represents buyers, sellers, and relocators across the Grapevine Lake
        suburbs — with bilingual support and investor-informed guidance when it helps the deal.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/contact/">Request a consultation</a>
        <a class="btn btn-outline-light" href="/areas/">Explore areas</a>
        <a class="btn btn-outline-light" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="container row">
      <div><strong>Monument Realty</strong><span>Brokerage</span></div>
      <div><strong>Hablo Español</strong><span>Bilingual</span></div>
      <div><strong>Investor-informed</strong><span>Background</span></div>
      <div><strong>Flower Mound</strong><span>Based</span></div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How clients work with Diego</p>
        <h2>Representation with a point of view</h2>
        <p>Not a portal handoff — a plan for buying, selling, or investing in the suburbs that actually fit your life.</p>
      </div>
      <div class="grid-3">
        <a class="media-card" href="/buyers/">
          <img src="/images/cities/highland-village.jpg" alt="Modern North DFW home exterior" loading="lazy" />
          <div class="shade"></div>
          <div class="body">
            <h3>Buy</h3>
            <p>Shortlists, tour strategy, and offer clarity — including remote relocators.</p>
          </div>
        </a>
        <a class="media-card" href="/sellers/">
          <img src="/images/cities/flower-mound.jpg" alt="Well-presented home ready for listing" loading="lazy" />
          <div class="shade"></div>
          <div class="body">
            <h3>Sell</h3>
            <p>Pricing, prep that matters, and a calm path through negotiations.</p>
          </div>
        </a>
        <a class="media-card" href="/about/">
          <img src="/images/cities/bartonville.jpg" alt="Real estate investment planning" loading="lazy" />
          <div class="shade"></div>
          <div class="body">
            <h3>Invest</h3>
            <p>Comps, rents, and risk flags informed by hands-on investing experience.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Service area</p>
        <h2>Built around the Grapevine Lake belt</h2>
        <p>Every town below is an active market for Diego — Flower Mound, Coppell, Grapevine Lake communities, and the smaller towns around them.</p>
      </div>
      <div class="area-grid">
        {featured.map((a) => (
          <a class="area-tile" href={`/areas/${a.slug}/`}>
            <img src={a.img} alt={`${a.name}, Texas`} loading="lazy" />
            <div class="shade"></div>
            <div class="body">
              <h3>{a.name}</h3>
            </div>
          </a>
        ))}
      </div>
      <div class="city-chips" style="margin-top:1.5rem;">
        {moreCities.map((c) => (
          <a href={`/areas/${c.slug}/`}>{c.name}</a>
        ))}
      </div>
      <p style="margin-top:1rem;"><a href="/areas/">View all service areas →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="round-img">
        <img src="/images/cities/grapevine.jpg" alt="Grapevine Main Street, Texas" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">Insights</p>
        <h2>Local research, written to decide — not to fill a blog</h2>
        <p>
          City comparisons, relocator notes, and practical buyer/seller guides for the
          Flower Mound–Grapevine Lake corridor — written so you can decide with clearer local context.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/insights/flower-mound-vs-highland-village/">Flower Mound vs Highland Village</a>
          <a class="btn btn-secondary" href="/insights/">All insights</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container split">
      <div>
        <p class="eyebrow">Proof</p>
        <h2>Reviews where clients already look</h2>
        <p>
          Google first for local visibility, then Zillow. On-site quotes are published only
          with permission — never invented.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={site.gbp} target="_blank" rel="noopener">Google reviews</a>
          <a class="btn btn-secondary" href={site.zillowReviews} target="_blank" rel="noopener">Zillow reviews</a>
          <a class="btn btn-secondary" href="/about/">Meet Diego</a>
        </div>
      </div>
      <div class="panel">
        <h3>Hablo Español</h3>
        <p>
          ¿Prefiere hablar del proceso en español? Diego atiende con claridad en inglés y en
          español para que su familia pueda hacer las preguntas importantes sin fricción.
        </p>
        <p style="margin:0;"><a href="/contacto/">Iniciar una conversación →</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Straight answers before the first call</h2>
      </div>
      <div class="faq" style="max-width:48rem;">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Private consultation, start to finish</h2>
          <p>Buying, selling, relocating, or investing — every relationship starts with a conversation.</p>
        </div>
        <div class="hero-actions" style="margin:0;">
          <a class="btn btn-on-dark" href="/contact/">Request a consult</a>
          <a class="btn btn-outline-light" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import { site } from '../data/site';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, ${site.brandSecondary}`}>
      <img class="brand__mark" src="/images/logo-icon.svg?v=2" alt="" width="64" height="40" decoding="async" />
      <span class="brand__copy">
        <span class="brand__name">{site.name}</span>
        <span class="brand__sub">{site.brandSecondary}</span>
      </span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/areas/">Areas</a>
      <div class="nav-dd">
        <a href="/client-services/" class="nav-dd__trigger">Client services</a>
        <div class="nav-dd__menu" role="list">
          <a href="/buyers/" role="listitem">Buyers</a>
          <a href="/sellers/" role="listitem">Sellers</a>
          <a href="/investors/" role="listitem">Investors</a>
          <a href="/property-alerts/" role="listitem">Property alerts</a>
        </div>
      </div>
      <a href="/insights/">Insights</a>
      <a href="/about/">About</a>
      <a href="/reviews/">Reviews</a>
      <a class="btn btn-nav" href="/contact/">Consult</a>
    </nav>
  </div>
</header>

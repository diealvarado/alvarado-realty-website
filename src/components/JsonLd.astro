---
import { site } from '../data/site';
const data = {
  '@context': 'https://schema.org',
  '@type': ['Person', 'RealEstateAgent'],
  name: site.name,
  url: site.url,
  image: `${site.url}/og-default.svg`,
  email: site.email,
  telephone: site.phone,
  jobTitle: 'REALTOR®',
  worksFor: { '@type': 'RealEstateAgent', name: site.brokerage },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  areaServed: [
    'Flower Mound TX',
    'Highland Village TX',
    'Lewisville TX',
    'Grapevine TX',
    'North Dallas Fort Worth',
  ],
  knowsLanguage: ['en', 'es'],
  sameAs: [site.gbp, site.zillowReviews, site.social.instagram, site.social.facebook, site.social.linkedin],
};
---
<script type="application/ld+json" set:html={JSON.stringify(data)} />

---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>{site.name}</strong>
      <p style="margin:0 0 .75rem;">{site.brandSecondary}<br />{site.brokerage}</p>
      <p style="margin:0;">
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        {site.address.full}
      </p>
      <p style="margin:.85rem 0 0;color:#94a3b8;font-size:.9rem;"><a href="/contacto/">Hablo Español</a></p>
    </div>
    <div>
      <h3 style="color:#fff;font-family:var(--display);font-size:1.25rem;margin:0 0 .75rem;">Explore</h3>
      <p style="margin:0;line-height:1.9;">
        <a href="/areas/">Service areas</a><br />
        <a href="/client-services/">Client services</a><br />
        <a href="/buyers/">Buyers</a><br />
        <a href="/sellers/">Sellers</a><br />
        <a href="/investors/">Investors</a><br />
        <a href="/property-alerts/">Property alerts</a><br />
        <a href="/home-value/">Home value</a><br />
        <a href="/insights/">Insights</a><br />
        <a href="/about/">About</a>
      </p>
    </div>
    <div>
      <h3 style="color:#fff;font-family:var(--display);font-size:1.25rem;margin:0 0 .75rem;">Stay in touch</h3>
      <p style="margin:0 0 1rem;line-height:1.9;">
        <a href={site.gbp} target="_blank" rel="noopener">Google reviews</a><br />
        <a href={site.zillowReviews} target="_blank" rel="noopener">Zillow reviews</a><br />
        <a href="/ai-information/">AI / entity info</a><br />
        <a href="/contact/">Contact</a>
      </p>
      <p style="margin:0 0 .5rem;color:#fff;font-weight:600;">Newsletter</p>
      <p style="margin:0 0 .75rem;font-size:.9rem;color:#94a3b8;">Occasional local notes — not a daily blast.</p>
      <form class="form form-inline form-on-dark" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
        <input type="hidden" name="form-name" value="newsletter" />
        <p hidden><label>Don’t fill this out: <input name="bot-field" /></label></p>
        <label class="sr-only" for="footer-newsletter-email">Email</label>
        <input id="footer-newsletter-email" type="email" name="email" placeholder="Email address" required />
        <button class="btn btn-nav" type="submit">Subscribe</button>
      </form>
    </div>
  </div>
  <div class="container footer-legal">
    <p style="margin:0 0 .55rem;color:#fff;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;">Texas Real Estate disclosures</p>
    <p class="trec-links" style="margin:0 0 1rem;font-size:10pt;line-height:1.8;">
      <a href="https://files.alvaradorealtygroup.com/Consumer_Protection_Notice.pdf" target="_blank" rel="noopener">Texas Real Estate Commission Consumer Protection Notice</a><br />
      <a href="https://files.alvaradorealtygroup.com/Diego-Alvarado-Information_about_Brokerage_Services.pdf" target="_blank" rel="noopener">Texas Real Estate Commission Information About Brokerage Services</a><br />
      <a href="https://www.trec.texas.gov/" target="_blank" rel="noopener">TREC Disclaimer</a>
    </p>
    <p style="margin:0 0 .75rem;font-size:.85rem;color:#94a3b8;">
      Licensed by the Texas Real Estate Commission. The Texas Real Estate Commission administers
      TRELA and can assist with questions or complaints about real estate license holders.
      Visit <a href="https://www.trec.texas.gov/" target="_blank" rel="noopener">www.trec.texas.gov</a>
      or call 512-936-3000.
    </p>
    <p style="margin:0 0 .5rem;">
      Diego Alvarado, REALTOR® · Texas Real Estate License #{site.license} · {site.brokerage}.
      Equal Housing Opportunity. Information deemed reliable but not guaranteed.
    </p>
    <p style="margin:0;"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
  </div>
</footer>
